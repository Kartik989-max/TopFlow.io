NODE_ENV=development
PORT=3000

# MongoDB — credentials must be provided via environment, never committed.
MONGODB_URI=

# Provider selection: mock | public | live
MARKET_DATA_PROVIDER=mock

# Market hours (NSE equity regular session)
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN=09:15
MARKET_CLOSE=15:30

# Snapshot cadence (milliseconds)
SNAPSHOT_INTERVAL_MS=10000

# NIFTY 50 index
INDEX_NAME=NIFTY50

# Strategy defaults
TOP_N=5
MIN_RELATIVE_VOLUME=1.5
REQUIRE_POSITIVE_5M_MOMENTUM=true
REQUIRE_POSITIVE_10M_MOMENTUM=false
REQUIRE_ABOVE_VWAP=false

# Data quality
DATA_STALE_AFTER_SECONDS=30
MAX_DATA_AGE_SECONDS=30

# Groww provider (only used when MARKET_DATA_PROVIDER=live)
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=

# Retention
RAW_DATA_RETENTION_DAYS=90

# MongoDB database name (defaults to 'topflow')
MONGODB_DB_NAME=topflow

# Dev/test fallback: boot against an ephemeral in-memory mongod (mongodb-memory-server)
USE_MEMORY_SERVER=false

# NSE trading holidays are hardcoded per year (+2026). Set to add dates.
MARKET_HOLIDAYS=

# ---- Demo/test only (NOT for production) ----
# Force market OPEN for a bounded window outside real NSE hours (e.g. Sunday).
# Real production runs must leave this unset.
MARKET_FORCE_OPEN=false
FORCE_OPEN_MINUTES=15

# Prior synthetic trading days to seed into history for relative-volume calc.
MOCK_HISTORY_DAYS=5
